{
    "_comment": "Mideye Shield iApp settings definitions. Each entry describes one configurable variable shown in the iApp UI. The 'name' is the static variable suffix used in RULE_INIT of MIDEYE_SHIELD_COMMON (i.e. static::MIDEYE_SHIELD_<name>). The 'section' and 'field' together form the iApp variable name $::section__field, which is also the placeholder __section__field__ inside the iRule body. The generator cross-checks 'name' against the actual RULE_INIT declarations and warns on any mismatch.",

    "sections": [
        {
            "id": "log",
            "label": "Debug",
            "fields": [
                {
                    "name": "log_debug",
                    "field": "debug",
                    "label": "Enable Debug Logging",
                    "type": "choice",
                    "display": "small",
                    "default": "0",
                    "choices": [
                        {"value": "1", "label": "Yes"},
                        {"value": "0", "label": "No"}
                    ]
                }
            ]
        },
        {
            "id": "api",
            "label": "API Settings",
            "fields": [
                {
                    "name": "api_base_url",
                    "field": "base_url",
                    "label": "API Base URL",
                    "type": "string",
                    "required": true,
                    "display": "xlarge",
                    "default": "https://shield.prod.mideye.com/api/v2"
                },
                {
                    "name": "api_client_id",
                    "field": "client_id",
                    "label": "API Client ID",
                    "type": "string",
                    "required": true,
                    "display": "xlarge",
                    "default": ""
                },
                {
                    "name": "api_client_secret",
                    "field": "client_secret",
                    "label": "API Client Secret",
                    "type": "string",
                    "required": true,
                    "display": "xlarge",
                    "default": ""
                },
                {
                    "name": "api_scope",
                    "field": "scope",
                    "label": "API OAuth2 Scope",
                    "type": "string",
                    "required": true,
                    "display": "xlarge",
                    "default": "api://app-mideye-shield-prod/.default"
                },
                {
                    "name": "api_token_url",
                    "field": "token_url",
                    "label": "API OAuth2 Token URL",
                    "type": "string",
                    "required": true,
                    "display": "xlarge",
                    "default": "https://login.prod.mideye.com/oauth2/v2.0/token"
                },
                {
                    "name": "api_timeout",
                    "field": "timeout",
                    "label": "API Timeout (ms)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "2500"
                },
                {
                    "name": "api_token_safeguard",
                    "field": "token_safeguard",
                    "label": "API Token Safeguard (seconds shaved off token lifetime)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "30"
                },
                {
                    "name": "api_down_cache_time",
                    "field": "down_cache_time",
                    "label": "API Down Cache Time (seconds)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "5"
                },
                {
                    "name": "api_retry_after",
                    "field": "retry_after",
                    "label": "API Retry After (seconds)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "30"
                }
            ]
        },
        {
            "id": "behaviour",
            "label": "Behaviour",
            "fields": [
                {
                    "name": "disabled",
                    "field": "disabled",
                    "label": "Bypass All Shield Checks",
                    "type": "choice",
                    "display": "small",
                    "default": "0",
                    "choices": [
                        {"value": "1", "label": "Yes"},
                        {"value": "0", "label": "No"}
                    ]
                },
                {
                    "name": "dry_run",
                    "field": "dry_run",
                    "label": "Dry Run Mode",
                    "type": "choice",
                    "display": "small",
                    "default": "0",
                    "choices": [
                        {"value": "1", "label": "Yes"},
                        {"value": "0", "label": "No"}
                    ]
                }
            ]
        },
        {
            "id": "score",
            "label": "Score Thresholds and Caching",
            "fields": [
                {
                    "name": "score_hard_deny",
                    "field": "hard_deny",
                    "label": "Hard Deny Threshold (score at or above is denied)",
                    "type": "string",
                    "required": true,
                    "display": "small",
                    "default": "70"
                },
                {
                    "name": "score_warn",
                    "field": "warn",
                    "label": "Warn Threshold (score at or above logs a warning)",
                    "type": "string",
                    "required": true,
                    "display": "small",
                    "default": "40"
                },
                {
                    "name": "score_cache_time",
                    "field": "cache_time",
                    "label": "Connection Score Cache Time (seconds)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "300"
                },
                {
                    "name": "login_score_cache_time",
                    "field": "login_cache_time",
                    "label": "Login Score Cache Time (seconds)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "10"
                },
                {
                    "name": "score_deny_cache_time",
                    "field": "deny_cache_time",
                    "label": "Deny Score Cache Time (seconds, for blocked IPs)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "86400"
                }
            ]
        },
        {
            "id": "pending",
            "label": "Pending Queue",
            "fields": [
                {
                    "name": "pending_max",
                    "field": "max",
                    "label": "Max Pending Connections per IP",
                    "type": "string",
                    "required": true,
                    "display": "small",
                    "default": "10"
                },
                {
                    "name": "pending_poll_interval",
                    "field": "poll_interval",
                    "label": "Pending Poll Interval (ms)",
                    "type": "string",
                    "required": true,
                    "display": "small",
                    "default": "100"
                }
            ]
        },
        {
            "id": "infra",
            "label": "Infrastructure",
            "fields": [
                {
                    "name": "dns",
                    "field": "dns",
                    "label": "DNS Server (IP or Virtual Server, leave empty for default)",
                    "type": "string",
                    "required": false,
                    "display": "large",
                    "default": ""
                }
            ]
        },
        {
            "id": "hssr",
            "label": "HSSR Helper",
            "fields": [
                {
                    "name": "hssr_mode",
                    "field": "mode",
                    "label": "HSSR Helper",
                    "type": "choice",
                    "display": "medium",
                    "default": "existing",
                    "runtime": false,
                    "choices": [
                        {"value": "existing", "label": "Use an existing HSSR helper"},
                        {"value": "install", "label": "Install an HSSR helper for me"}
                    ]
                },
                {
                    "name": "hssr_irule",
                    "field": "irule",
                    "label": "HSSR iRule (full path, e.g. /Common/HSSR)",
                    "type": "string",
                    "required": true,
                    "display": "large",
                    "default": "/Common/HSSR",
                    "runtime": false,
                    "optional": "hssr.mode == \"existing\""
                },
                {
                    "name": "hssr_helper_vs",
                    "field": "helper_vs",
                    "label": "HSSR Helper Virtual Server (full path)",
                    "type": "string",
                    "required": true,
                    "display": "large",
                    "default": "/Common/HSSR-helper-vs",
                    "runtime": false,
                    "optional": "hssr.mode == \"existing\""
                },
                {
                    "name": "hssr_vs_ip",
                    "field": "vs_ip",
                    "label": "Helper VS IP address (non-routable recommended, e.g. 192.0.2.2)",
                    "type": "string",
                    "required": true,
                    "display": "medium",
                    "default": "192.0.2.2",
                    "runtime": false,
                    "validator": "IpAddress",
                    "optional": "hssr.mode == \"install\""
                },
                {
                    "name": "hssr_vs_port",
                    "field": "vs_port",
                    "label": "Helper VS port",
                    "type": "string",
                    "required": true,
                    "display": "small",
                    "default": "9999",
                    "runtime": false,
                    "validator": "PortNumber",
                    "optional": "hssr.mode == \"install\""
                },
                {
                    "name": "hssr_ssl_profile",
                    "field": "ssl_profile",
                    "label": "Server SSL Profile for the helper VS",
                    "type": "ssl_profile_choice",
                    "display": "large",
                    "default": "/Common/serverssl",
                    "runtime": false,
                    "optional": "hssr.mode == \"install\""
                }
            ]
        },
        {
            "id": "hash",
            "label": "Username Hashing",
            "fields": [
                {
                    "name": "username_salt",
                    "field": "username_salt",
                    "label": "Username Salt (leave empty to auto-generate)",
                    "type": "string",
                    "required": false,
                    "display": "xlarge",
                    "default": ""
                }
            ]
        }
    ]
}
