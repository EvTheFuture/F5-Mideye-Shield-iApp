# Create or update each iRule
#
# tmsh::create is automatically converted to tmsh::modify on iApp re-entry
# by the BIG-IP "mark-and-sweep" framework, so a single call works for both
# first deployment and re-deploys. The framework also handles deletion of
# orphaned objects on iApp delete, so no explicit cleanup is needed.
# ---------------------------------------------------------------------------
# ----- Deploy iRule: MIDEYE_SHIELD_APM -----
set _BODY_MIDEYE_SHIELD_APM [string map ${_SUBST_MAP} $_BODY_MIDEYE_SHIELD_APM]
tmsh::create ltm rule MIDEYE_SHIELD_APM $_BODY_MIDEYE_SHIELD_APM

# ----- Deploy iRule: MIDEYE_SHIELD_COMMON -----
set _BODY_MIDEYE_SHIELD_COMMON [string map ${_SUBST_MAP} $_BODY_MIDEYE_SHIELD_COMMON]
tmsh::create ltm rule MIDEYE_SHIELD_COMMON $_BODY_MIDEYE_SHIELD_COMMON

# ----- Deploy iRule: MIDEYE_SHIELD_CONNECTION -----
set _BODY_MIDEYE_SHIELD_CONNECTION [string map ${_SUBST_MAP} $_BODY_MIDEYE_SHIELD_CONNECTION]
tmsh::create ltm rule MIDEYE_SHIELD_CONNECTION $_BODY_MIDEYE_SHIELD_CONNECTION


